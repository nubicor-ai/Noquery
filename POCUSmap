<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>noquery // ER Resuscitation Diagnostic Co-Pilot</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @keyframes scanline {
      0% { transform: translateY(-100%); }
      100% { transform: translateY(1000%); }
    }
    .scan-beam {
      animation: scanline 3.5s linear infinite;
    }
    .crt-glow {
      text-shadow: 0 0 10px rgba(16, 185, 129, 0.4);
    }
    /* Custom Scrollbar */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #0f172a; }
    ::-webkit-scrollbar-thumb { background: #334155; border-radius: 3px; }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 font-sans min-h-screen flex flex-col antialiased selection:bg-emerald-500 selection:text-slate-950">

  <!-- TOP RESUSCITATION HUD HEADER -->
  <header class="bg-slate-900/90 border-b border-slate-800 px-6 py-3.5 backdrop-blur-md sticky top-0 z-50 flex items-center justify-between shadow-2xl">
    <div class="flex items-center gap-4">
      <div class="flex items-center gap-2">
        <div class="h-3 w-3 rounded-full bg-emerald-500 animate-ping"></div>
        <div class="h-3 w-3 rounded-full bg-emerald-500 -ml-5"></div>
        <span class="font-black text-2xl tracking-tighter text-white crt-glow">noquery<span class="text-emerald-400">.ai</span></span>
      </div>
      <div class="h-5 w-px bg-slate-800"></div>
      <div class="flex items-center gap-2 text-xs font-mono uppercase bg-slate-800/80 px-2.5 py-1 rounded text-slate-300 border border-slate-700/60">
        <i class="fa-solid fa-hospital-user text-emerald-400"></i>
        <span>Bay 01: Critical Resus</span>
      </div>
      <div class="hidden lg:flex items-center gap-2 text-xs font-mono bg-amber-500/10 text-amber-300 border border-amber-500/30 px-2.5 py-1 rounded">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span>Bedside CT Prohibited (Hemodynamically Unstable)</span>
      </div>
    </div>

    <!-- LIVE TELEMETRY STREAM STRIP -->
    <div class="flex items-center gap-4 text-xs font-mono">
      <div class="flex items-center gap-2 bg-slate-950/70 border border-slate-800 px-3 py-1.5 rounded-lg shadow-inner">
        <span class="text-slate-500 font-bold">HR:</span>
        <span id="vital-hr" class="text-rose-400 font-black text-sm">138</span>
        <span class="text-[10px] text-slate-600">BPM</span>
      </div>
      <div class="flex items-center gap-2 bg-slate-950/70 border border-slate-800 px-3 py-1.5 rounded-lg shadow-inner">
        <span class="text-slate-500 font-bold">BP:</span>
        <span id="vital-bp" class="text-rose-400 font-black text-sm">74/42</span>
        <span class="text-[10px] text-slate-600">(MAP 52)</span>
      </div>
      <div class="flex items-center gap-2 bg-slate-950/70 border border-slate-800 px-3 py-1.5 rounded-lg shadow-inner">
        <span class="text-slate-500 font-bold">SpO₂:</span>
        <span id="vital-spo2" class="text-cyan-400 font-black text-sm">91%</span>
      </div>
      <div class="flex items-center gap-2 bg-slate-950/70 border border-slate-800 px-3 py-1.5 rounded-lg shadow-inner">
        <span class="text-slate-500 font-bold">Shock Index:</span>
        <span id="vital-si" class="text-amber-400 font-black text-sm">1.86</span>
        <span class="text-[10px] text-rose-500 font-bold animate-pulse">CRIT</span>
      </div>
      <button onclick="toggleResusNoteModal()" class="bg-emerald-600 hover:bg-emerald-500 text-slate-950 font-bold text-xs uppercase px-3 py-1.5 rounded transition flex items-center gap-1.5 shadow-lg shadow-emerald-600/30">
        <i class="fa-solid fa-file-waveform"></i>
        <span>Auto-Note</span>
      </button>
    </div>
  </header>

  <!-- WORKFLOW BANNER: HARDWARE FEEDS & CLINICAL SCENARIOS -->
  <div class="bg-gradient-to-r from-slate-900 via-indigo-950/40 to-slate-900 border-b border-slate-800/80 px-6 py-2 flex flex-wrap items-center justify-between gap-3 text-xs text-slate-400">
    <div class="flex items-center gap-2">
      <!-- MP4 Upload Input (Hidden) -->
      <input type="file" id="video-file-input" accept="video/mp4,video/webm" class="hidden" onchange="handleFileUpload(event)">
      <button onclick="document.getElementById('video-file-input').click()" class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-cyan-300 border border-cyan-500/30 rounded flex items-center gap-1.5 transition">
        <i class="fa-solid fa-cloud-arrow-up"></i>
        <span>Upload MP4 Backup</span>
      </button>

      <!-- Free Camera / Screen Stream Controls -->
      <button onclick="startFreeCamera()" class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-emerald-300 border border-emerald-500/30 rounded flex items-center gap-1.5 transition">
        <i class="fa-solid fa-camera"></i>
        <span>Aim Camera at Monitor</span>
      </button>
      <button onclick="startFreeScreenShare()" class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-indigo-300 border border-indigo-500/30 rounded flex items-center gap-1.5 transition">
        <i class="fa-solid fa-desktop"></i>
        <span>Screen Share Feed</span>
      </button>
      <button id="reset-sim-btn" onclick="resetToSimulation()" class="hidden px-2.5 py-1 bg-rose-950/40 hover:bg-rose-900/60 text-rose-300 border border-rose-500/40 rounded flex items-center gap-1.5 transition">
        <i class="fa-solid fa-rotate-left"></i>
        <span>Reset to Simulation</span>
      </button>
    </div>

    <!-- Preset Scenario Selector -->
    <div class="flex items-center gap-3">
      <span class="text-slate-500 font-mono">Preset Scenarios:</span>
      <select id="case-selector" onchange="switchScenario(this.value)" class="bg-slate-950 border border-slate-700 text-slate-200 text-xs rounded px-2.5 py-1 font-mono focus:border-emerald-500 outline-none cursor-pointer">
        <option value="trauma">Case 1: Trauma / Occult Hemorrhage (Morrison's Bleed)</option>
        <option value="pe">Case 2: Massive PE / RV Strain (Acute Cor Pulmonale)</option>
        <option value="neuro">Case 3: Severe TBI / High ICP (ONSD Herniation Risk)</option>
        <option value="chf">Case 4: Flash Pulmonary Edema (Low EF + B-Lines)</option>
      </select>
    </div>
  </div>

  <!-- HIDDEN VIDEO ELEMENTS FOR HARDWARE / FILE STREAMS -->
  <video id="uploaded-video-source" loop muted playsinline class="hidden"></video>
  <video id="free-video-stream" autoplay playsinline class="hidden"></video>

  <!-- MAIN SIMULATOR WORKSPACE -->
  <main class="flex-1 grid grid-cols-12 gap-5 p-6 overflow-hidden">
    
    <!-- LEFT 7 COLS: STREAMING ULTRASOUND HUD WITH LIVE CALIPERS -->
    <section class="col-span-12 xl:col-span-7 flex flex-col gap-4">
      
      <!-- SCAN SELECTION TABS (HEAD TO TOE PROTOCOL) -->
      <div class="flex items-center justify-between bg-slate-900/60 p-1.5 rounded-xl border border-slate-800/90 text-xs font-mono">
        <div class="flex gap-1 overflow-x-auto">
          <button id="tab-neuro" onclick="setOrganWindow('neuro')" class="organ-tab px-3 py-1.5 rounded-lg flex items-center gap-2 bg-slate-950/60 text-slate-400 hover:text-slate-200 transition">
            <i class="fa-solid fa-brain text-purple-400"></i> 1. Neuro (ONSD)
          </button>
          <button id="tab-thorax" onclick="setOrganWindow('thorax')" class="organ-tab px-3 py-1.5 rounded-lg flex items-center gap-2 bg-slate-950/60 text-slate-400 hover:text-slate-200 transition">
            <i class="fa-solid fa-lungs text-cyan-400"></i> 2. Thorax (BLUE)
          </button>
          <button id="tab-pump" onclick="setOrganWindow('pump')" class="organ-tab px-3 py-1.5 rounded-lg flex items-center gap-2 bg-slate-950/60 text-slate-400 hover:text-slate-200 transition">
            <i class="fa-solid fa-heart-pulse text-rose-400"></i> 3. Pump (Echo)
          </button>
          <button id="tab-congestion" onclick="setOrganWindow('congestion')" class="organ-tab px-3 py-1.5 rounded-lg flex items-center gap-2 bg-slate-950/60 text-slate-400 hover:text-slate-200 transition">
            <i class="fa-solid fa-water text-blue-400"></i> 4. IVC/VExUS
          </button>
          <button id="tab-belly" onclick="setOrganWindow('belly')" class="organ-tab px-3 py-1.5 rounded-lg flex items-center gap-2 bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 transition">
            <i class="fa-solid fa-shield-halved text-emerald-400"></i> 5. eFAST (Belly)
          </button>
        </div>
        <button onclick="simulateFullSweep()" class="px-2.5 py-1 text-[11px] bg-indigo-600/30 hover:bg-indigo-600/50 text-indigo-300 border border-indigo-500/40 rounded flex items-center gap-1.5 transition">
          <i class="fa-solid fa-play text-[9px]"></i> Run 15s Sono-CT Sweep
        </button>
      </div>

      <!-- SIMULATED POCUS LIVE VIEWPORT -->
      <div class="relative bg-black rounded-2xl border-2 border-slate-800 overflow-hidden shadow-2xl flex-1 flex flex-col justify-between min-h-[440px]">
        
        <!-- CRT GRID & SCANLINE -->
        <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:16px_16px] opacity-40 pointer-events-none"></div>
        <div class="absolute inset-x-0 h-16 bg-gradient-to-b from-transparent via-emerald-500/10 to-transparent scan-beam pointer-events-none"></div>

        <!-- VIEWPORT OVERLAY HEADER -->
        <div class="relative z-10 p-4 flex justify-between items-start text-xs font-mono">
          <div class="bg-black/70 backdrop-blur-md px-3 py-2 rounded-lg border border-slate-800">
            <div class="flex items-center gap-2 text-emerald-400 font-bold">
              <span class="inline-block h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span id="window-title">WINDOW: Morrison's Pouch (Hepatorenal)</span>
            </div>
            <div class="text-[10px] text-slate-400 mt-0.5">Stream: Zero-Latency Video Core | Auto-Depth Calibrated</div>
          </div>
          <div class="flex flex-col items-end gap-1.5">
            <span class="bg-slate-900/90 text-cyan-300 border border-cyan-500/30 px-2.5 py-1 rounded text-[11px] font-bold">
              <i class="fa-solid fa-microchip mr-1"></i> Auto-Calipers: ACTIVE
            </span>
            <span id="ai-confidence" class="text-[10px] text-emerald-400 bg-black/80 px-2 py-0.5 rounded border border-emerald-500/30">
              Confidence: 98.4%
            </span>
          </div>
        </div>

        <!-- CANVAS FOR ULTRASOUND SIMULATION & AUTO-CALIPERS -->
        <div class="relative flex-1 flex items-center justify-center p-6">
          <canvas id="pocus-canvas" width="620" height="340" class="max-w-full rounded-lg shadow-inner"></canvas>
          
          <!-- DYNAMIC ON-SCREEN CALIPER TAG OVERLAY -->
          <div id="caliper-tag" class="absolute bg-slate-950/90 border border-rose-500/80 px-3 py-1.5 rounded-lg text-xs font-mono text-rose-300 shadow-2xl flex items-center gap-2">
            <i class="fa-solid fa-ruler-combined text-rose-400"></i>
            <div>
              <span class="text-[10px] text-slate-400 block" id="caliper-label">Free Fluid Stripe:</span>
              <span class="font-bold text-sm text-white" id="caliper-value">16.4 mm (~850 mL)</span>
            </div>
          </div>
        </div>

        <!-- VIEWPORT BOTTOM STATUS -->
        <div class="relative z-10 p-3 bg-slate-950/90 border-t border-slate-800 flex justify-between items-center text-[11px] font-mono text-slate-400">
          <div class="flex items-center gap-3">
            <span><i class="fa-solid fa-fingerprint text-emerald-400 mr-1"></i> Doctor: Hands on Probe</span>
            <span>|</span>
            <span id="fps-counter" class="text-slate-500">Latency: 12ms</span>
          </div>
          <div class="text-amber-400 flex items-center gap-1.5">
            <i class="fa-solid fa-bolt"></i>
            <span>Continuous calculations in stream. Zero freeze required.</span>
          </div>
        </div>
      </div>

      <!-- SCAN LOG & ACCUMULATED ANATOMICAL SCORECARD -->
      <div class="bg-slate-900/70 border border-slate-800 rounded-xl p-3 text-xs font-mono">
        <div class="text-slate-400 font-bold uppercase text-[10px] mb-2 flex justify-between">
          <span>Head-to-Toe Sono-CT Sweep Progress</span>
          <span id="sweep-status" class="text-emerald-400">5 / 5 Windows Analyzed</span>
        </div>
        <div class="grid grid-cols-5 gap-2 text-center text-[11px]">
          <div id="status-chip-neuro" class="bg-slate-950 border border-slate-800 p-2 rounded">
            <div class="text-slate-500 text-[10px]">1. Neuro</div>
            <div class="font-bold text-slate-300" id="chip-val-neuro">ONSD 4.8mm</div>
          </div>
          <div id="status-chip-thorax" class="bg-slate-950 border border-slate-800 p-2 rounded">
            <div class="text-slate-500 text-[10px]">2. Thorax</div>
            <div class="font-bold text-emerald-400" id="chip-val-thorax">A-Lines (Dry)</div>
          </div>
          <div id="status-chip-pump" class="bg-slate-950 border border-slate-800 p-2 rounded">
            <div class="text-slate-500 text-[10px]">3. Pump</div>
            <div class="font-bold text-rose-400" id="chip-val-pump">Hyperdynamic</div>
          </div>
          <div id="status-chip-congestion" class="bg-slate-950 border border-slate-800 p-2 rounded">
            <div class="text-slate-500 text-[10px]">4. IVC</div>
            <div class="font-bold text-rose-400" id="chip-val-congestion">92% Collapse</div>
          </div>
          <div id="status-chip-belly" class="bg-slate-950 border border-rose-500/60 bg-rose-500/10 p-2 rounded">
            <div class="text-rose-400 text-[10px]">5. eFAST</div>
            <div class="font-bold text-rose-300" id="chip-val-belly">+ Morrison Stripe</div>
          </div>
        </div>
      </div>
    </section>

    <!-- RIGHT 5 COLS: "NO QUERY" DECISION DIRECTIVE & ACTION -->
    <section class="col-span-12 xl:col-span-5 flex flex-col gap-4">
      
      <!-- THE ERADICATION OF THE "QUERY" TAG (CORE PITCH HOOK) -->
      <div class="bg-slate-900 border-2 border-slate-800 rounded-2xl p-5 shadow-2xl relative overflow-hidden">
        <div class="text-xs font-mono uppercase tracking-wider text-slate-500 mb-2 flex items-center justify-between">
          <span>Diagnostic Status Transformation</span>
          <span class="text-emerald-400 flex items-center gap-1"><i class="fa-solid fa-circle-check"></i> Loop Closed</span>
        </div>

        <!-- OLD QUERY STATUS (CROSSED OUT) -->
        <div class="bg-slate-950/80 border border-rose-500/30 p-3 rounded-xl mb-3 flex items-center justify-between opacity-75">
          <div>
            <div class="text-[10px] font-mono text-rose-400 uppercase tracking-widest flex items-center gap-1.5">
              <i class="fa-solid fa-circle-xmark"></i> Traditional Approach (Awaiting CT)
            </div>
            <div id="old-query-tag" class="text-sm font-mono text-slate-300 line-through mt-0.5">
              ? Shock / ? Sepsis / ? Trauma Bleed (Awaiting CT Abdomen)
            </div>
          </div>
          <span class="text-rose-500 text-xs font-mono font-bold bg-rose-500/15 px-2 py-1 rounded">DELAY: 75m</span>
        </div>

        <!-- NEW NOQUERY DIRECTIVE (DEFINITIVE PHENOTYPE) -->
        <div class="bg-gradient-to-br from-emerald-950/50 via-slate-950 to-slate-950 border-2 border-emerald-500/80 p-4 rounded-xl shadow-xl">
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-[10px] font-mono uppercase tracking-widest text-emerald-400 font-bold flex items-center gap-1.5">
              <i class="fa-solid fa-bolt"></i> noquery Bedside Phenotype
            </span>
            <span class="bg-emerald-500 text-slate-950 font-black text-[10px] px-2 py-0.5 rounded uppercase font-mono">
              Zero CT Required
            </span>
          </div>
          <div id="definitive-phenotype" class="text-lg font-black text-white leading-tight">
            Exsanguinating Hemoperitoneum & Hypovolemic Shock
          </div>
          <div id="phenotype-details" class="text-xs text-slate-300 mt-2 font-mono border-t border-slate-800/80 pt-2">
            Free Fluid in Morrison's Pouch (16.4mm stripe) + Flat IVC (0.5cm) + Hyperdynamic Empty LV. CT scanner bypassed safely.
          </div>
        </div>
      </div>

      <!-- INSTANT CLINICAL NEXT STEP DIRECTIVE (ZERO DECISION FATIGUE) -->
      <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-2xl flex-1 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-xs font-mono uppercase tracking-wider text-amber-400 font-bold flex items-center gap-2">
              <i class="fa-solid fa-hand-holding-medical"></i> Next Resuscitation Directives
            </h3>
            <span class="text-[10px] font-mono text-slate-500">Auto-Generated via Resus Engine</span>
          </div>

          <!-- DIRECTIVE ACTION ITEMS -->
          <div id="directive-list" class="space-y-2.5 font-mono text-xs">
            <!-- Directives dynamically injected here -->
          </div>
        </div>

        <!-- DOCTOR OVERRIDE / CONFIRMATION BUTTONS -->
        <div class="pt-4 border-t border-slate-800/80 mt-4 flex items-center gap-3">
          <button onclick="triggerImmediateAction()" class="flex-1 bg-emerald-600 hover:bg-emerald-500 text-slate-950 font-black text-xs uppercase py-3 rounded-xl transition flex items-center justify-center gap-2 shadow-lg shadow-emerald-600/30">
            <i class="fa-solid fa-check-double"></i>
            <span id="primary-action-btn">Confirm: Alert OR & Start MTP</span>
          </button>
          <button onclick="dismissDirective()" class="px-4 py-3 bg-slate-800 hover:bg-slate-700 text-slate-300 font-mono text-xs rounded-xl transition">
            Override
          </button>
        </div>
      </div>

      <!-- TIME SAVED & CLINICAL IMPACT CARD -->
      <div class="bg-slate-900/40 border border-slate-800/70 rounded-xl p-4 flex items-center justify-between text-xs font-mono">
        <div>
          <span class="text-slate-500 block text-[10px]">Door-to-Definitive Decision:</span>
          <span class="text-emerald-400 font-bold text-sm">3 min 12 sec</span>
        </div>
        <div class="h-6 w-px bg-slate-800"></div>
        <div>
          <span class="text-slate-500 block text-[10px]">Radiation Avoided:</span>
          <span class="text-cyan-400 font-bold text-sm">~14.5 mSv (Pan-Scan CT)</span>
        </div>
        <div class="h-6 w-px bg-slate-800"></div>
        <div>
          <span class="text-slate-500 block text-[10px]">Decision Fatigue:</span>
          <span class="text-purple-400 font-bold text-sm">Eliminated</span>
        </div>
      </div>

    </section>
  </main>

  <!-- AUTO-GENERATED RESUSCITATION NOTE MODAL -->
  <div id="note-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-700 rounded-2xl max-w-2xl w-full p-6 shadow-2xl font-mono text-xs flex flex-col max-h-[85vh]">
      <div class="flex justify-between items-center pb-3 border-b border-slate-800">
        <div class="flex items-center gap-2">
          <i class="fa-solid fa-file-waveform text-emerald-400 text-base"></i>
          <span class="text-sm font-bold text-white">noquery // Zero-Click Resuscitation Scribe Note</span>
        </div>
        <button onclick="toggleResusNoteModal()" class="text-slate-400 hover:text-white text-base">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <div class="flex-1 overflow-y-auto my-4 bg-slate-950 p-4 rounded-xl border border-slate-800 text-slate-300 space-y-3" id="note-content">
        <!-- Dynamically injected note -->
      </div>

      <div class="flex justify-end gap-3 pt-3 border-t border-slate-800">
        <button onclick="copyResusNote()" class="bg-slate-800 hover:bg-slate-700 text-slate-200 px-4 py-2 rounded-lg transition flex items-center gap-2">
          <i class="fa-regular fa-copy"></i> Copy to EMR
        </button>
        <button onclick="toggleResusNoteModal()" class="bg-emerald-600 hover:bg-emerald-500 text-slate-950 font-bold px-4 py-2 rounded-lg transition">
          Done
        </button>
      </div>
    </div>
  </div>

  <!-- JAVASCRIPT SIMULATOR & COMPUTER VISION ENGINE -->
  <script>
    const scenarios = {
      trauma: {
        title: "Occult Hemorrhage / Ruptured Spleen",
        vitals: { hr: 138, bp: "74/42", map: 52, spo2: 91, si: 1.86 },
        oldQuery: "? Shock / ? Sepsis / ? Trauma Bleed (Awaiting CT Abdomen)",
        phenotype: "Exsanguinating Hemoperitoneum & Hypovolemic Shock",
        details: "Free Fluid in Morrison's Pouch (16.4mm stripe) + Flat IVC (0.5cm) + Hyperdynamic Empty LV. Bypassing CT for immediate Laparotomy.",
        chips: {
          neuro: "ONSD 4.8mm",
          thorax: "A-Lines (Dry)",
          pump: "Hyperdynamic (VTI 8.2)",
          congestion: "92% Collapse (Flat)",
          belly: "+ Morrison (16.4mm)"
        },
        activeWindow: "belly",
        caliper: { label: "Free Fluid Stripe (RUQ):", val: "16.4 mm (~850 mL Blood)" },
        directives: [
          { icon: "fa-person-booth", color: "text-rose-400", title: "BYPASS CT SCANNER", text: "Patient hemodynamically unstable. Direct transfer to Emergency Operating Room (OR)." },
          { icon: "fa-droplet", color: "text-rose-400", title: "ACTIVATE MASSIVE TRANSFUSION (MTP)", text: "Initiate balanced 1:1:1 pRBC, FFP, and Platelets via rapid infuser." },
          { icon: "fa-syringe", color: "text-amber-400", title: "TRANEXAMIC ACID (TXA)", text: "Administer 1g IV push over 10 min, followed by 1g infusion over 8 hrs." }
        ],
        primaryAction: "Confirm: Alert OR & Start MTP"
      },
      pe: {
        title: "Massive Pulmonary Embolism",
        vitals: { hr: 126, bp: "82/50", map: 60, spo2: 86, si: 1.53 },
        oldQuery: "? Massive PE vs. ? Severe Pneumonia (Awaiting CT Pulmonary Angio)",
        phenotype: "Acute Cor Pulmonale & Obstructive Shock",
        details: "Severe RV Dilation (RV:LV 1.34) + McConnell's Sign + Plethoric Non-Collapsible IVC (2.4cm). Negative lung consolidation.",
        chips: {
          neuro: "ONSD 5.1mm",
          thorax: "No B-lines / Clear",
          pump: "RV:LV 1.34 (Severe Strain)",
          congestion: "0% Collapse (Plethoric)",
          belly: "Clear (No fluid)"
        },
        activeWindow: "pump",
        caliper: { label: "RV:LV Basal Diameter Ratio:", val: "1.34 (Normal < 0.9)" },
        directives: [
          { icon: "fa-ban", color: "text-rose-400", title: "HOLD IV FLUID BOLUS", text: "Avoid fluid loading. Right ventricle is acutely overloaded and failing." },
          { icon: "fa-pills", color: "text-rose-400", title: "STAGE THROMBOLYTIC THERAPY", text: "Prepare systemic tPA (Alteplase 50mg or 100mg) for hemodynamically unstable PE." },
          { icon: "fa-heart-pulse", color: "text-cyan-400", title: "START NOREPINEPHRINE", text: "Titrate to restore coronary perfusion pressure (Target MAP > 65)." }
        ],
        primaryAction: "Confirm: Initiate Thrombolysis Protocol"
      },
      neuro: {
        title: "Severe TBI with Impending Herniation",
        vitals: { hr: 48, bp: "192/108", map: 136, spo2: 95, si: 0.25 },
        oldQuery: "? Intracranial Bleed / ? Cushing's Response (Awaiting NCCT Head)",
        phenotype: "Critical Intracranial Hypertension (Impending Herniation)",
        details: "Optic Nerve Sheath Diameter 6.42mm bilaterally + Severe Cushing's Triad (Severe HTN + Bradycardia).",
        chips: {
          neuro: "ONSD 6.42mm (CRIT)",
          thorax: "Normal Sliding",
          pump: "Hyperdynamic LV",
          congestion: "IVC 1.6cm (Normal)",
          belly: "Clear"
        },
        activeWindow: "neuro",
        caliper: { label: "Optic Nerve Sheath (3mm depth):", val: "6.42 mm (Threshold > 5.8mm)" },
        directives: [
          { icon: "fa-bed", color: "text-purple-400", title: "NEUROPROTECTIVE POSITIONING", text: "Elevate head of bed to 30 degrees. Ensure midline cervical alignment." },
          { icon: "fa-prescription-bottle-medical", color: "text-rose-400", title: "HYPEROSMOLAR THERAPY", text: "Administer 3% Hypertonic Saline (250mL bolus) or Mannitol (1g/kg IV)." },
          { icon: "fa-triangle-exclamation", color: "text-amber-400", title: "DEFER LUMBAR PUNCTURE", text: "High risk of cerebral uncal herniation. Immediate neurosurgical consultation." }
        ],
        primaryAction: "Confirm: Push 3% Saline & Alert Neurosurgery"
      },
      chf: {
        title: "Acute Cardiogenic Flash Pulmonary Edema",
        vitals: { hr: 114, bp: "185/115", map: 138, spo2: 83, si: 0.61 },
        oldQuery: "? COPD Exacerbation vs. ? Cardiogenic Edema vs. ? ARDS (Awaiting Chest CT)",
        phenotype: "Cardiogenic Pulmonary Congestion & Hypertensive Crisis",
        details: "Diffuse Confluent B-Lines (8/8 Zones) + Severely Depressed LVEF (<25%) + Distended Plethoric IVC (2.5cm).",
        chips: {
          neuro: "ONSD 4.9mm",
          thorax: "B-Lines Confluent (8/8)",
          pump: "LVEF <25% (Akinesis)",
          congestion: "Plethoric / VExUS Gr 3",
          belly: "Mild Hepatic Congestion"
        },
        activeWindow: "thorax",
        caliper: { label: "Thoracic Aeration Loss:", val: "Confluent B-Profile (>5/Zone)" },
        directives: [
          { icon: "fa-mask-ventilator", color: "text-cyan-400", title: "INITIATE NON-INVASIVE VENTILATION (BiPAP)", text: "Start IPAP 10 / EPAP 5 cmH2O. Monitor diaphragm thickening fraction." },
          { icon: "fa-syringe", color: "text-rose-400", title: "HIGH-DOSE IV NITROGLYCERIN", text: "Push 400-800mcg bolus followed by high-dose infusion to reduce LV afterload." },
          { icon: "fa-ban", color: "text-rose-400", title: "STRICT ZERO CRYSTALLOID", text: "Patient is in end-organ fluid overload. Avoid all volume expansion." }
        ],
        primaryAction: "Confirm: Start BiPAP & High-Dose Nitrates"
      }
    };

    let currentCaseKey = "trauma";
    let currentOrgan = "belly";
    let streamMode = 'simulation'; // 'simulation', 'video', 'camera'

    const canvas = document.getElementById('pocus-canvas');
    const ctx = canvas.getContext('2d');
    const uploadedVideo = document.getElementById('uploaded-video-source');
    const freeVideo = document.getElementById('free-video-stream');

    // FILE UPLOAD HANDLER
    function handleFileUpload(event) {
      const file = event.target.files[0];
      if (!file) return;

      const fileURL = URL.createObjectURL(file);
      uploadedVideo.src = fileURL;
      uploadedVideo.play();
      streamMode = 'video';

      document.getElementById('window-title').innerText = `PLAYBACK: ${file.name.substring(0, 20)}...`;
      document.getElementById('fps-counter').innerText = "Mode: MP4 Local Stream";
      document.getElementById('reset-sim-btn').classList.remove('hidden');
    }

    // CAMERA CAPTURE (AIMED AT MONITOR)
    async function startFreeCamera() {
      try {
        const stream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: "environment" }
        });
        freeVideo.srcObject = stream;
        streamMode = 'camera';
        document.getElementById('window-title').innerText = "STREAM: Camera Monitor Capture (Live)";
        document.getElementById('fps-counter').innerText = "Mode: Optical Input";
        document.getElementById('reset-sim-btn').classList.remove('hidden');
      } catch (err) {
        alert("Camera access denied or unavailable: " + err.message);
      }
    }

    // WIRELESS SCREEN SHARE CAPTURE
    async function startFreeScreenShare() {
      try {
        const stream = await navigator.mediaDevices.getDisplayMedia({ video: true });
        freeVideo.srcObject = stream;
        streamMode = 'camera';
        document.getElementById('window-title').innerText = "STREAM: Wireless Screen Share (Live)";
        document.getElementById('fps-counter').innerText = "Mode: Display Stream";
        document.getElementById('reset-sim-btn').classList.remove('hidden');
      } catch (err) {
        console.error("Screen share canceled:", err);
      }
    }

    function resetToSimulation() {
      streamMode = 'simulation';
      uploadedVideo.pause();
      if (freeVideo.srcObject) {
        freeVideo.srcObject.getTracks().forEach(track => track.stop());
      }
      document.getElementById('reset-sim-btn').classList.add('hidden');
      setOrganWindow(currentOrgan);
    }

    // MAIN DRAW LOOP
    function drawUltrasoundSimulation() {
      ctx.fillStyle = '#05070c';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      if (streamMode === 'video' && uploadedVideo.readyState >= 2) {
        // Render uploaded MP4
        ctx.drawImage(uploadedVideo, 0, 0, canvas.width, canvas.height);
        drawCalipersOverlay();
      } else if (streamMode === 'camera' && freeVideo.readyState >= 2) {
        // Render camera or screen share feed
        ctx.drawImage(freeVideo, 0, 0, canvas.width, canvas.height);
        drawCalipersOverlay();
      } else {
        // Render built-in procedural ultrasound simulation
        renderProceduralScan();
      }

      requestAnimationFrame(drawUltrasoundSimulation);
    }

    // PROCEDURAL SIMULATION FOR THE 5 HEAD-TO-TOE WINDOWS
    function renderProceduralScan() {
      const time = Date.now() * 0.003;

      ctx.save();
      ctx.beginPath();
      ctx.moveTo(canvas.width / 2, 10);
      ctx.arc(canvas.width / 2, 10, 310, Math.PI * 0.28, Math.PI * 0.72);
      ctx.closePath();
      ctx.clip();

      // Acoustic noise texture
      for (let i = 0; i < 350; i++) {
        const x = Math.random() * canvas.width;
        const y = Math.random() * canvas.height;
        const alpha = Math.random() * 0.15;
        ctx.fillStyle = `rgba(255,255,255,${alpha})`;
        ctx.fillRect(x, y, 2, 2);
      }

      if (currentOrgan === 'belly') {
        // Morrison's Pouch (Hepatorenal recess)
        ctx.fillStyle = 'rgba(120, 140, 160, 0.25)';
        ctx.beginPath();
        ctx.ellipse(240, 150, 120, 80, 0.2, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = 'rgba(90, 110, 130, 0.28)';
        ctx.beginPath();
        ctx.ellipse(380, 210, 80, 50, -0.3, 0, Math.PI * 2);
        ctx.fill();

        // Anechoic free fluid stripe
        ctx.fillStyle = '#000000';
        ctx.beginPath();
        ctx.moveTo(270, 140);
        ctx.bezierCurveTo(320, 170, 340, 190, 360, 240);
        ctx.lineTo(340, 245);
        ctx.bezierCurveTo(325, 195, 305, 175, 255, 145);
        ctx.closePath();
        ctx.fill();

        // Caliper distance line
        ctx.strokeStyle = '#ef4444';
        ctx.lineWidth = 2;
        ctx.setLineDash([4, 2]);
        ctx.beginPath();
        ctx.moveTo(310, 172);
        ctx.lineTo(334, 188);
        ctx.stroke();
        ctx.setLineDash([]);

        drawCrosshair(310, 172, '#ef4444');
        drawCrosshair(334, 188, '#ef4444');

        ctx.strokeStyle = 'rgba(239, 68, 68, 0.5)';
        ctx.strokeRect(260, 130, 120, 120);

      } else if (currentOrgan === 'pump') {
        // Echo View
        const beat = Math.sin(time * 3) * 8;
        ctx.strokeStyle = 'rgba(180, 200, 220, 0.4)';
        ctx.lineWidth = 3;
        ctx.strokeRect(320 + beat/2, 100, 80 - beat, 140);

        const isPE = currentCaseKey === 'pe';
        const rvWidth = isPE ? 100 + beat : 60 + beat;
        ctx.strokeStyle = isPE ? '#f43f5e' : 'rgba(180, 200, 220, 0.4)';
        ctx.strokeRect(200 - beat/2, 100, rvWidth, 135);

        if (isPE) {
          ctx.strokeStyle = '#f43f5e';
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(200, 170);
          ctx.lineTo(300, 170);
          ctx.stroke();
          drawCrosshair(200, 170, '#f43f5e');
          drawCrosshair(300, 170, '#f43f5e');
        }

      } else if (currentOrgan === 'neuro') {
        // Optic Nerve Sheath
        ctx.fillStyle = 'rgba(80, 90, 110, 0.3)';
        ctx.beginPath();
        ctx.arc(310, 90, 60, 0, Math.PI);
        ctx.fill();

        ctx.fillStyle = '#020408';
        ctx.fillRect(285, 90, 50, 180);

        ctx.strokeStyle = '#a855f7';
        ctx.lineWidth = 1;
        ctx.setLineDash([2, 2]);
        ctx.beginPath();
        ctx.moveTo(260, 150);
        ctx.lineTo(360, 150);
        ctx.stroke();
        ctx.setLineDash([]);

        ctx.strokeStyle = '#a855f7';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(285, 150);
        ctx.lineTo(335, 150);
        ctx.stroke();
        drawCrosshair(285, 150, '#a855f7');
        drawCrosshair(335, 150, '#a855f7');

      } else if (currentOrgan === 'thorax') {
        // Pleural line
        ctx.strokeStyle = '#38bdf8';
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(150, 90);
        ctx.lineTo(470, 90);
        ctx.stroke();

        const isCHF = currentCaseKey === 'chf';
        const numLines = isCHF ? 6 : 0;
        for (let j = 0; j < numLines; j++) {
          const xPos = 180 + j * 50 + Math.sin(time + j) * 5;
          ctx.fillStyle = 'rgba(56, 189, 248, 0.25)';
          ctx.fillRect(xPos, 90, 18, 220);
        }

      } else if (currentOrgan === 'congestion') {
        // IVC Dynamics
        const collapse = Math.sin(time * 1.5) * 20;
        ctx.fillStyle = '#000000';
        ctx.beginPath();
        ctx.moveTo(180, 130 + collapse/2);
        ctx.lineTo(440, 130 + collapse/2);
        ctx.lineTo(440, 200 - collapse/2);
        ctx.lineTo(180, 200 - collapse/2);
        ctx.closePath();
        ctx.fill();

        ctx.strokeStyle = '#38bdf8';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(310, 130 + collapse/2);
        ctx.lineTo(310, 200 - collapse/2);
        ctx.stroke();
        drawCrosshair(310, 130 + collapse/2, '#38bdf8');
        drawCrosshair(310, 200 - collapse/2, '#38bdf8');
      }

      ctx.restore();
    }

    function drawCalipersOverlay() {
      // Overlays calipers directly onto incoming live video frames
      ctx.strokeStyle = '#ef4444';
      ctx.lineWidth = 2;
      ctx.strokeRect(260, 120, 130, 110);
      drawCrosshair(300, 175, '#ef4444');
      drawCrosshair(330, 175, '#ef4444');
    }

    function drawCrosshair(x, y, color) {
      ctx.strokeStyle = color;
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(x - 4, y);
      ctx.lineTo(x + 4, y);
      ctx.moveTo(x, y - 4);
      ctx.lineTo(x, y + 4);
      ctx.stroke();
    }

    // SCENARIO SWITCHING
    function switchScenario(caseKey) {
      currentCaseKey = caseKey;
      const data = scenarios[caseKey];

      document.getElementById('vital-hr').innerText = data.vitals.hr;
      document.getElementById('vital-bp').innerText = data.vitals.bp;
      document.getElementById('vital-spo2').innerText = data.vitals.spo2 + '%';
      document.getElementById('vital-si').innerText = data.vitals.si;

      document.getElementById('old-query-tag').innerText = data.oldQuery;
      document.getElementById('definitive-phenotype').innerText = data.phenotype;
      document.getElementById('phenotype-details').innerText = data.details;

      document.getElementById('chip-val-neuro').innerText = data.chips.neuro;
      document.getElementById('chip-val-thorax').innerText = data.chips.thorax;
      document.getElementById('chip-val-pump').innerText = data.chips.pump;
      document.getElementById('chip-val-congestion').innerText = data.chips.congestion;
      document.getElementById('chip-val-belly').innerText = data.chips.belly;

      const listContainer = document.getElementById('directive-list');
      listContainer.innerHTML = '';
      data.directives.forEach((dir, idx) => {
        const item = document.createElement('div');
        item.className = "bg-slate-950 p-3 rounded-xl border border-slate-800 flex items-start gap-3 hover:border-slate-700 transition";
        item.innerHTML = `
          <div class="mt-0.5"><i class="fa-solid ${dir.icon} ${dir.color} text-sm"></i></div>
          <div class="flex-1">
            <div class="font-bold text-slate-200 text-xs">${idx + 1}. ${dir.title}</div>
            <div class="text-[11px] text-slate-400 mt-0.5">${dir.text}</div>
          </div>
        `;
        listContainer.appendChild(item);
      });

      document.getElementById('primary-action-btn').innerText = data.primaryAction;
      setOrganWindow(data.activeWindow);
    }

    // ORGAN TAB SWITCHING
    function setOrganWindow(organKey) {
      currentOrgan = organKey;
      const organNames = {
        neuro: "Optic Nerve Sheath (ONSD)",
        thorax: "BLUE Lung Protocol (Anterior)",
        pump: "Parasternal / Apical 4-Chamber Echo",
        congestion: "Inferior Vena Cava (Subxiphoid)",
        belly: "Morrison's Pouch (Hepatorenal Space)"
      };

      if (streamMode === 'simulation') {
        document.getElementById('window-title').innerText = `WINDOW: ${organNames[organKey]}`;
      }

      document.querySelectorAll('.organ-tab').forEach(tab => {
        tab.className = "organ-tab px-3 py-1.5 rounded-lg flex items-center gap-2 bg-slate-950/60 text-slate-400 hover:text-slate-200 transition";
      });
      document.getElementById(`tab-${organKey}`).className = "organ-tab px-3 py-1.5 rounded-lg flex items-center gap-2 bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 transition";

      const activeData = scenarios[currentCaseKey];
      document.getElementById('caliper-label').innerText = activeData.caliper.label;
      document.getElementById('caliper-value').innerText = activeData.caliper.val;
    }

    // AUTOMATED 15-SECOND PAN-SCAN SWEEP FOR PRESENTATION
    function simulateFullSweep() {
      const organs = ['neuro', 'thorax', 'pump', 'congestion', 'belly'];
      let idx = 0;
      const interval = setInterval(() => {
        setOrganWindow(organs[idx]);
        idx++;
        if (idx >= organs.length) {
          clearInterval(interval);
        }
      }, 2500);
    }

    function triggerImmediateAction() {
      alert(`[DIRECTIVE CONFIRMED]\n${document.getElementById('primary-action-btn').innerText}\n\nPre-staged orders dispatched to trauma team.`);
    }

    function dismissDirective() {
      alert("Physician Override Logged. Clinical reasoning saved for departmental audit.");
    }

    function toggleResusNoteModal() {
      const modal = document.getElementById('note-modal');
      const data = scenarios[currentCaseKey];
      
      const noteHTML = `
        <div class="text-emerald-400 font-bold border-b border-slate-800 pb-1 mb-2">RESUSCITATION EMERGENCY SUMMARY NOTE (ZERO-CLICK AUTO SCRIBE)</div>
        <div><strong>Patient Acuity:</strong> Level 1 (Crashing / Resus Bay 1)</div>
        <div><strong>Presentation:</strong> Undifferentiated Shock (Shock Index: ${data.vitals.si})</div>
        <div><strong>Initial Triage Tag:</strong> <span class="line-through">${data.oldQuery}</span></div>
        <div><strong>Confirmed Bedside Phenotype:</strong> <span class="text-emerald-300 font-bold">${data.phenotype}</span></div>
        <br>
        <div class="text-slate-400 font-bold">MULTI-ORGAN SONO-CT FINDINGS:</div>
        <div>• <strong>Neuro (ONSD):</strong> ${data.chips.neuro}</div>
        <div>• <strong>Thorax (Lungs):</strong> ${data.chips.thorax}</div>
        <div>• <strong>Cardiac (FoCUS):</strong> ${data.chips.pump}</div>
        <div>• <strong>Preload (IVC):</strong> ${data.chips.congestion}</div>
        <div>• <strong>Peritoneal Cavity (eFAST):</strong> ${data.chips.belly}</div>
        <br>
        <div class="text-slate-400 font-bold">CLINICAL ACTIONS EXECUTED:</div>
        <div>1. Diagnostic CT scan bypassed due to acute hemodynamic instability and confirmed bedside ultrasound pathology.</div>
        <div>2. Immediate definitive treatment initiated: ${data.directives[0].title}.</div>
        <div>3. Attending Physician: Verified real-time calculations.</div>
      `;

      document.getElementById('note-content').innerHTML = noteHTML;
      modal.classList.toggle('hidden');
    }

    function copyResusNote() {
      navigator.clipboard.writeText(document.getElementById('note-content').innerText).then(() => {
        alert("Resuscitation note copied to clipboard! Ready to paste into EMR.");
      });
    }

    // INITIALIZE
    window.onload = () => {
      switchScenario('trauma');
      drawUltrasoundSimulation();
    };
  </script>
